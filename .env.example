# URL base do TSE para dados oficiais de resultados (padrão: oficial)
TSE_CDN_BASE_URL=https://resultados.tse.jus.br/oficial

# Código da eleição presidencial de 2026 (2º turno ordinária federal)
NEXT_PUBLIC_DEFAULT_ELECTION_CODE=6258

# Código da eleição estadual de 2026 (2º turno ordinária estadual)
NEXT_PUBLIC_STATE_ELECTION_CODE=6260

# Cache revalidate time em segundos para a API interna (padrão 15 segundos)
API_CACHE_TTL_SECONDS=15
